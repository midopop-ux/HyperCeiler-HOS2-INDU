<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:quick_restart="com.mi.android.globallauncher">

    <PreferenceCategory android:title="@string/home_navigation_title">
        <SwitchPreference
            android:defaultValue="true"
            android:key="prefs_key_home_navigation_third_party_launcher"
            android:summary="@string/home_navigation_third_party_launcher_desc"
            android:title="@string/home_navigation_third_party_launcher" />

        <Preference
            android:dependency="prefs_key_home_navigation_third_party_launcher"
            android:key="prefs_key_home_gesture_bar_long_press_action_info"
            android:title="Long press on Gesture Bar"
            android:summary="Trigger Circle to Search matching Home button setting in Framework" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_home_navigation_disable_full_screen_back_gesture"
            android:title="@string/home_navigation_disable_full_screen_back_gesture" />

        <Preference
            android:fragment="com.sevtinge.hyperceiler.hooker.home.HomeGestureSettings"
            android:key="prefs_key_home_gesture"
            android:title="@string/home_gesture"
            app:inflatedXml="@xml/home_gesture" />
    </PreferenceCategory>

</PreferenceScreen>
